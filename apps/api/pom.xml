<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.14</version>
    <relativePath/>
  </parent>

  <groupId>com.ledgerly</groupId>
  <artifactId>api</artifactId>
  <version>0.1.0</version>
  <name>api</name>
  <description>Ledgerly system-of-record API</description>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <testcontainers.version>1.21.4</testcontainers.version>
    <testcontainers-redis.version>2.2.4</testcontainers-redis.version>
    <jqwik.version>1.9.1</jqwik.version>
    <jjwt.version>0.12.6</jjwt.version>
    <json-schema-validator.version>1.5.6</json-schema-validator.version>
    <postgresql.version>42.7.12</postgresql.version>
    <jackson-bom.version>2.21.4</jackson-bom.version>
    <netty.version>4.1.136.Final</netty.version>
    <tomcat.version>10.1.55</tomcat.version>
    <pdfbox.version>3.0.8</pdfbox.version>
    <micrometer.version>1.15.12</micrometer.version>
    <spring-framework.version>6.2.19</spring-framework.version>
    <spring-data-bom.version>2025.0.13</spring-data-bom.version>
    <aws-sdk.version>2.46.18</aws-sdk.version>
    <httpcore5.version>5.4.3</httpcore5.version>
    <sentry.version>8.53.0</sentry.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-api</artifactId>
      <version>${jjwt.version}</version>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-impl</artifactId>
      <version>${jjwt.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-jackson</artifactId>
      <version>${jjwt.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <!-- Compile-scoped, not runtime: PolicyChunkRepository binds pgvector's PGvector type
           directly, which itself implements org.postgresql.util.PGBinaryObject. -->
    </dependency>
    <dependency>
      <groupId>com.pgvector</groupId>
      <artifactId>pgvector</artifactId>
      <version>0.1.6</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.redis</groupId>
      <artifactId>testcontainers-redis</artifactId>
      <version>${testcontainers-redis.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>net.jqwik</groupId>
      <artifactId>jqwik</artifactId>
      <version>${jqwik.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- The API validates untrusted extraction output against the shared schema at runtime. -->
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
      <version>${json-schema-validator.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.pdfbox</groupId>
      <artifactId>pdfbox</artifactId>
      <version>${pdfbox.version}</version>
    </dependency>
    <!-- R2 is S3-compatible; this is the "prod" profile's StorageClient backend (T2). Pinned
         directly rather than via the awssdk BOM since this is the only AWS SDK module in use —
         import the BOM instead if a second one is ever added, to avoid transitive version skew. -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>s3</artifactId>
      <version>${aws-sdk.version}</version>
    </dependency>
    <!-- T6: minimal error tracking. -jakarta is the Boot 3.x build (javax vs jakarta namespace
         split) — see docs/decisions.md if the plain sentry-spring-boot-starter is ever tried
         here by mistake, it silently fails to autoconfigure against jakarta servlet types. -->
    <dependency>
      <groupId>io.sentry</groupId>
      <artifactId>sentry-spring-boot-starter-jakarta</artifactId>
      <version>${sentry.version}</version>
    </dependency>
  </dependencies>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- Pulled in transitively by the AWS SDK's apache5-client (s3 -> httpclient5 -> here),
           which still resolves 5.3.6: CVE-2026-54399 and CVE-2026-54428, both HIGH DoS via
           oversized headers. Managed forward to the first fixed release rather than pinned
           per-dependency, so both core5 artifacts move together and the SDK's own upgrade
           does not silently drag either back down. -->
      <dependency>
        <groupId>org.apache.httpcomponents.core5</groupId>
        <artifactId>httpcore5</artifactId>
        <version>${httpcore5.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.httpcomponents.core5</groupId>
        <artifactId>httpcore5-h2</artifactId>
        <version>${httpcore5.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <finalName>api</finalName>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <!-- Keep docs/contracts as the single checked-in source while embedding the exact schema
           that the production API validates. -->
      <resource>
        <directory>${project.basedir}/../../docs/contracts</directory>
        <includes>
          <include>extraction-proposal.schema.json</include>
        </includes>
        <targetPath>contracts</targetPath>
      </resource>
      <!-- T5.1/T5.2 generate these PDFs (scripts/demo_seed/); T5.5's demo seed re-uploads the
           exact same bytes through the real storage layer, so the fixture and the blob it
           describes can never drift apart into two hand-copied trees. -->
      <resource>
        <directory>${project.basedir}/../../scripts/demo_seed/pdfs</directory>
        <includes>
          <include>**/*.pdf</include>
        </includes>
        <targetPath>db/seed/pdfs</targetPath>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <!-- Spring Boot's parent excludes **/*IT.java from surefire, so without failsafe the
           integration tests never run in a plain `mvn test` — a green build would then say
           nothing about the ledger-write, tenant-isolation or pipeline assertions, which are
           exactly the ones that matter. `mvn verify` is the real gate. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <!-- Stated rather than left to the default (which also matches IT*.java and
               *ITCase.java) so one suffix decides membership. Failsafe scans compiled classes,
               so a target/test-classes entry whose source has since been deleted or renamed is
               still a candidate: it then fails to resolve with a message naming the class, not
               the staleness. `mvn clean verify` is the reliable invocation after a branch
               switch, and what CI runs. -->
          <includes>
            <include>**/*IT.java</include>
          </includes>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
