# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Database ---
POSTGRES_DB=ledgerly
POSTGRES_USER=ledgerly
POSTGRES_PASSWORD=change-me-locally
DATABASE_URL=jdbc:postgresql://localhost:5432/ledgerly
AI_DATABASE_URL=postgresql://ledgerly:change-me-locally@localhost:5432/ledgerly

# --- api (Spring Boot) ---
API_PORT=8080
JWT_SECRET=generate-a-long-random-value
JWT_EXPIRY_MINUTES=60
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=generate-a-separate-long-random-value
UPLOAD_MAX_BYTES=10485760
# Empty/unset disables Sentry entirely (its own SDK default) — leave blank for local dev.
SENTRY_DSN=
SENTRY_ENVIRONMENT=local

# --- api storage backend ---
# LocalDiskStorage is used locally and in every profile except "prod" — nothing below is
# needed for local dev. R2StorageClient only activates under SPRING_PROFILES_ACTIVE=prod
# (see docs/decisions.md, 2026-08-25 ADR on object storage).
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=generate-an-r2-api-token
# R2_SECRET_ACCESS_KEY=generate-an-r2-api-token-secret
# R2_BUCKET=ledgerly-documents

# --- ai (FastAPI) ---
AI_PORT=8000
# Use deterministic local providers. Configure both providers and keys for a real AI run.
AI_LLM_PROVIDER=fake
AI_LLM_API_KEY=fake
AI_EMBEDDING_PROVIDER=fake
# For a real run, this must be a Voyage AI key (voyageai.com), not the same key as
# AI_LLM_API_KEY — the OpenCode Go gateway AI_LLM_API_KEY authenticates against only proxies
# chat completion, not embeddings. See docs/decisions.md, 2026-08-25 entry on this.
AI_EMBEDDING_API_KEY=fake
AI_SENTRY_DSN=
AI_SENTRY_ENVIRONMENT=local

# --- load test tuning ---
# docker-compose.yml defaults both to 30 if unset; only needed to run scripts/loadtest.sh
# against a different quota.
LOADTEST_DOCUMENT_QUOTA=30
LOADTEST_AI_QUOTA=30

# --- web (Next.js) ---
# API_URL is what web's own server-side route handlers/Server Actions call (compose defaults
# it to the api container's internal DNS name); NEXT_PUBLIC_API_URL is what a browser-side
# fetch would use instead — see docs/architecture.md for which paths take which one.
API_URL=http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_AI_URL=http://localhost:8000
# The real public domain (e.g. https://ledgerly.vercel.app) once deployed — resolves the
# absolute og:image/twitter:image URLs Next.js generates from opengraph-image.tsx. Falls back
# to localhost:3000 if unset, which is correct for local dev but wrong for a real deploy.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Public because Sentry DSNs are meant to be embedded in client-side bundles — not a secret,
# just a write-only ingest endpoint. Empty/unset disables the SDK.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=local
