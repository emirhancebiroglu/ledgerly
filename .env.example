# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Database ---
POSTGRES_DB=ledgerly
POSTGRES_USER=ledgerly
POSTGRES_PASSWORD=change-me-locally
DATABASE_URL=jdbc:postgresql://localhost:5432/ledgerly
AI_DATABASE_URL=postgresql://ledgerly:change-me-locally@localhost:5432/ledgerly

# --- api (Spring Boot) ---
API_PORT=8080
JWT_SECRET=generate-a-long-random-value
JWT_EXPIRY_MINUTES=60
AI_SERVICE_URL=http://localhost:8000
UPLOAD_MAX_BYTES=10485760

# --- ai (FastAPI) ---
AI_PORT=8000
# Provider is decided at M4. Until then FakeLlmClient is used.
LLM_PROVIDER=fake
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# --- web (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8080
